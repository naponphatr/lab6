extends Node3D

# ----------------------------------------------------------------------------------- #
# GameManager เป็น Autoload (Singleton) ดังนั้นค่า score จะ "ไม่รีเซ็ต" เองตอนเปลี่ยนฉาก
# สคริปต์นี้แปะไว้ที่ root node ของแต่ละด่าน เพื่อรีเซ็ตคะแนน/ไอเท็มให้เป็น 0 ทุกครั้งที่เข้าฉากใหม่
# ถ้าไม่อยากให้รีเซ็ต (เช่นอยากสะสมคะแนนรวมทั้งเกม) ก็แค่เอาสคริปต์นี้ออกจาก node ได้เลย
# ----------------------------------------------------------------------------------- #

func _ready():
	GameManager.score = 0
